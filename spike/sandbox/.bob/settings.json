{
  "hooks": {
    "SessionStart":     [{ "hooks": [{ "type": "command", "command": "node ../hook.mjs", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node ../hook.mjs", "timeout": 5 }] }],
    "PreToolUse":       [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node ../hook.mjs", "timeout": 5 }] }],
    "PostToolUse":      [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node ../hook.mjs", "timeout": 5 }] }],
    "PreCompact":       [{ "hooks": [{ "type": "command", "command": "node ../hook.mjs", "timeout": 5 }] }],
    "PostCompact":      [{ "hooks": [{ "type": "command", "command": "node ../hook.mjs", "timeout": 5 }] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "node ../hook.mjs", "timeout": 5 }] }]
  }
}
