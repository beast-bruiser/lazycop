# Copy to .env (gitignored) to let LazyCop write card options and diff cards with Granite.
# Without these, LazyCop still works: cards show Bob's own words only.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Optional
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-4-h-small
# WATSONX_IAM_URL=https://iam.cloud.ibm.com/identity/token
LAZYCOP_LLM_MAX_CALLS=60
