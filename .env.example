# ============================================
# WATSONX HACKATHON - ENVIRONMENT VARIABLES
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to ~/.lazycop/.env, where LazyCop reads it (outside any repo),
#    or set LAZYCOP_ENV_FILE to another path. A .env in this repo is gitignored too.
#    Command: mkdir -p ~/.lazycop && cp .env.example ~/.lazycop/.env && chmod 600 ~/.lazycop/.env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# IBM Cloud API Key (WATSONX_API_KEY is also accepted)
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT

# ============================================
# LAZYCOP - GRANITE CARD WRITER (optional)
# ============================================
# Without these, LazyCop still works: cards show Bob's own words only.
#
# The watsonx.ai project the API key's user belongs to (watsonx.ai > project > Manage > General)
WATSONX_PROJECT_ID=your_project_id_here
# The API endpoint of the project's region, not the website address:
#   Dallas https://us-south.ml.cloud.ibm.com · Frankfurt https://eu-de.ml.cloud.ibm.com
#   London https://eu-gb.ml.cloud.ibm.com · Tokyo https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-4-h-small
# WATSONX_IAM_URL=https://iam.cloud.ibm.com/identity/token
LAZYCOP_LLM_MAX_CALLS=60

# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Use process.env.VARIABLE_NAME to access values
# - Never share credentials with AI assistants like Bob
# ============================================
